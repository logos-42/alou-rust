{
  "name": "alou-edge",
  "version": "0.2.5",
  "description": "Alou Edge - Web3 AI Agent on Cloudflare Workers",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "clean": "node ./scripts/worker-build.js --clean-only",
    "dev": "npm run build:wasm && npm run fix:wasm && npx wrangler dev",
    "deploy": "npm run build:wasm && npx wrangler deploy",
    "build": "npm run build:wasm && node ./scripts/worker-build.js",
    "build:cargo": "cargo build --target wasm32-unknown-unknown --release",
    "build:wasm": "cargo build --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir build target/wasm32-unknown-unknown/release/alou_edge.wasm && node ./scripts/fix-wasm-init.js",
    "fix:wasm": "node ./scripts/fix-wasm-init.js",
    "build:ts": "tsc --noEmit",
    "test": "cargo test",
    "secret:list": "npx wrangler secret list",
    "secret:put": "npx wrangler secret put"
  },
  "keywords": [
    "cloudflare-workers",
    "web3",
    "ai-agent",
    "blockchain"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/alou-pay/aloupay"
  },
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.1.74",
    "@anthropic-ai/sdk": "^0.71.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.60.0"
  }
}
