        {
          "key": "WORKER_URL",
          "value": "https://alou-edge.yuanjieliu65.workers.dev",
          "enabled": true
        },
        {
          "key": "WALLET_ADDRESS",
          "value": "0x1234567890123456789012345678901234567890",
          "enabled": true
        },
        {
          "key": "SESSION_ID",
          "value": "",
          "enabled": true
        }
      ]
    }
  ],
  "info": {
    "name": "Alou Edge API Collection",
    "description": "API测试集合，用于测试部署在Cloudflare Workers的Alou Edge后端服务",
