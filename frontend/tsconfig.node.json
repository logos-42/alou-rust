{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "playwright.config.*",
    "e2e/**/*"
  ]
}
