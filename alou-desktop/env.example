# 环境变量示例配置
# 复制此文件为 .env.local 进行本地配置

# API基础URL配置
# 开发模式：留空（使用Vite代理）
# 生产模式：https://alou-edge.yuanjieliu65.workers.dev
VITE_API_BASE_URL=

# 启用离线模式（后端不可用时）
# true: 启用离线模式，API配置保存到本地
# false: 禁用离线模式，必须连接后端
VITE_OFFLINE_MODE=true

# 开发服务器端口
PORT=1420

# 本地API配置示例（后端不可用时使用）
# 这些配置会在离线模式下生效
LOCAL_API_PROVIDER=deepseek
LOCAL_API_MODEL=deepseek-chat
# LOCAL_API_KEY=your-api-key-here  # 在实际使用时配置
