    {
      "name": "健康检查",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              ""
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{WORKER_URL}}/api/health"
        }
      }
    },
    {
      "name": "创建会话",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    pm.collectionVariables.set('SESSION_ID', response.session_id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": JSON.stringify({
            "wallet_address": "{{WALLET_ADDRESS}}",
            "chain": "ethereum"
          }, null, 2)
        },
        "url": {
          "raw": "{{WORKER_URL}}/api/session"
        }
      }
    },
