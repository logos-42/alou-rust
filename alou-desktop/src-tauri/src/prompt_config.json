  "decision_strategies": [
    {
      "name": "Standard Tool Usage",
      "description": "标准工具使用策略",
      "conditions": [
        {
          "condition_type": "ResourceAvailability",
          "parameters": {
            "resource_type": "tool"
          }
        }
      ],
      "actions": [
        {
          "action_type": "UseTool",
          "parameters": {
            "max_retries": "3"
          }
        }
      ]
    },
    {
      "name": "Error Recovery",
      "description": "错误恢复策略",
      "conditions": [
        {
          "condition_type": "ToolFailure",
          "parameters": {
            "failure_type": "transient"
          }
        }
      ],
      "actions": [
        {
          "action_type": "Retry",
          "parameters": {
            "delay_seconds": "5"
          }
        }
      ]
    },
    {
      "name": "Critical Failure",
      "description": "严重故障处理策略",
      "conditions": [
        {
          "condition_type": "ToolFailure",
          "parameters": {
            "failure_type": "critical"
          }
        }
      ],
      "actions": [
        {
          "action_type": "Abort",
          "parameters": {
            "notify_user": "true"
          }
        }
      ]
    }
  ],
  "risk_assessment": {
    "level": "Medium",
    "factors": [
      {
        "name": "Data Loss",
        "impact": 0.8,
        "probability": 0.1
      },
      {
        "name": "Privacy Breach",
        "impact": 1.0,
